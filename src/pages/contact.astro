import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="it">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <ContactForm
        heading="Contattaci"
        action="https://formspree.io/f/mykgeqdy"
      />
    </main>
    <Footer />
  </body>
</html>
