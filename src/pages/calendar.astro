---
/**
 * Calendar Event Display Page
 *
 * Purpose:
 * Fetches and displays upcoming events from a public Google Calendar (via iCalendar feed).
 * Handles different event types properly (all-day vs timed) and presents them with
 * appropriate date/time formatting.
 *
 * Key Features:
 * - Sanitizes event descriptions by removing Google Meet links and support documentation
 * - Displays timed events on the same calendar day with start time only (e.g., "14 aprile 14:30")
 * - Shows full date range with times for events spanning multiple days (e.g., "14 aprile 23:00 - 15 aprile 01:00")
 * - All-day events show only the date without times (e.g., "14 aprile")
 * - Events are sorted chronologically and filtered to show only future events
 */

import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import ical from "node-ical";

// Fetch the ics file
const icalUrl =
  "https://calendar.google.com/calendar/ical/c_07e44ac03455c9b1e8e5ee8c1d758a243855038cabb4afd18c567c7495304b42%40group.calendar.google.com/public/basic.ics";
const googleCalendarLink = `https://www.google.com/calendar/render?cid=${encodeURIComponent(icalUrl)}`;
const response = await fetch(icalUrl);
if (!response.ok) {
  throw new Error(`Calendar fetch failed with status ${response.status}`);
}

const text = await response.text();
if (!text.trim()) {
  throw new Error("Calendar fetch returned an empty ICS payload");
}

let data;
try {
  data = ical.parseICS(text);
} catch (error) {
  const parseErrorMessage =
    error instanceof Error ? error.message : String(error);
  throw new Error(`Calendar ICS parse failed: ${parseErrorMessage}`, {
    cause: error instanceof Error ? error : undefined,
  });
}

const dateOpts = { weekday: "long", day: "2-digit", month: "long" };
const timeOpts = { hour: "2-digit", minute: "2-digit" };
const DAY_MS = 24 * 60 * 60 * 1000;
const now = new Date();

const sanitizeDescription = (description?: string) => {
  if (!description) return undefined;

  const cleaned = description
    .split(/\r?\n/)
    .filter(
      (line: string) =>
        !/google meet|meet\.google\.com|support\.google\.com\//i.test(line),
    )
    .join("\n")
    .trim();

  return cleaned || undefined;
};

// Helper to check if two dates are on the same calendar day
const isSameDay = (date1: Date, date2: Date) => {
  return (
    date1.getFullYear() === date2.getFullYear() &&
    date1.getMonth() === date2.getMonth() &&
    date1.getDate() === date2.getDate()
  );
};

// Convert to a clean array
const events = Object.values(data)
  .filter((event) => event && event.type === "VEVENT")
  // not interested in past events
  .filter((event) => new Date(event?.start) >= now)
  .map((event) => {
    const startDate = new Date(event?.start);
    let endDate = new Date(event?.end);

    // For all-day events, subtract 24h to get the correct display date
    if (event?.start?.dateOnly) {
      endDate = new Date(endDate - DAY_MS);
    }

    const sameDay = isSameDay(startDate, endDate);

    return {
      title: event?.summary,
      description: sanitizeDescription(event?.description),
      start: startDate.toLocaleDateString("it-IT", dateOpts),
      startTime:
        sameDay && !event?.start?.dateOnly
          ? startDate.toLocaleTimeString("it-IT", timeOpts)
          : "",
      end: endDate.toLocaleDateString("it-IT", dateOpts),
      endTime: !sameDay ? endDate.toLocaleTimeString("it-IT", timeOpts) : "",
      sameDay,
      startRaw: startDate,
    };
  })
  .sort((a, b) => a.startRaw - b.startRaw);

if (events.length === 0) {
  throw new Error(
    "Calendar contains 0 upcoming events; aborting build to avoid empty output",
  );
}
---

<!doctype html>
<html lang="it">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <h1>Calendario Eventi {now.getFullYear()}</h1>
      <div class="calendar-grid">
        {
          events.map((event) => (
            <div class="event-card">
              <h3>{event.title}</h3>
              <div class="event-date">
                {event.sameDay
                  ? `${event.start} ${event.startTime}`
                  : event.startTime
                    ? `${event.start} ${event.startTime} - ${event.end} ${event.endTime}`
                    : `${event.start} - ${event.end}`}
              </div>
              {event.description && <p>{event.description}</p>}
            </div>
          ))
        }
        <div>
          <a href={googleCalendarLink}>Aggiungi al tuo Google Calendar</a>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .calendar-grid {
    display: grid;
    margin-top: 2rem;
    gap: 1rem;
  }
  .event-card {
    border: 1px solid #ccc;
    padding: 1rem;
  }
  .event-date {
    font-size: 1rem;
    color: #666;
    margin-bottom: 0.5rem;
  }
</style>
